# 复制为 .env 并填写；不要提交真实密钥
AEGIS_OFFLINE=1                      # 1=离线 FakeLLM（测试）；0=真实模型
AEGIS_API_BASE=                      # OpenAI 兼容端点
AEGIS_API_KEY=
AEGIS_PLANNER_MODEL=gpt-4o           # 规划用强模型
AEGIS_WORKER_MODEL=gpt-4o-mini       # 抽取/摘要用快模型
AEGIS_REVIEWERS=gpt-4o,gpt-4-turbo   # 逗号分隔的评审模型
AEGIS_MAX_TOKENS=400000              # Token 预算（熔断闸门）
AEGIS_MAX_TOOL_CALLS=300
AEGIS_MAX_ITERATIONS=25
AEGIS_MAX_REFLECTIONS=4
AEGIS_SANDBOX=1
AEGIS_SANDBOX_NET=aegis_sandbox
AEGIS_MEMORY_BACKEND=local           # local | chroma
AEGIS_MEMORY_DIR=./data/memory
AEGIS_AUDIT=./data/audit.log
AEGIS_ROE=./roe.yaml
